# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# Dev: SQLite file. Prod: swap to postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Storage ---
# "local" for dev, "s3" for production
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-data
MAX_UPLOAD_SIZE_MB=200

# --- S3 (only used when STORAGE_DRIVER=s3) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=personal-cloud-drive
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Default quota (bytes) for new users: 10 GB ---
DEFAULT_STORAGE_QUOTA=10737418240
